// Clinic Management System — PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AppointmentSource {
  WEBSITE
  ADMIN
  WALK_IN
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentPreference {
  ONLINE
  COUNTER
}

enum ReminderStatus {
  PENDING
  DONE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InventoryTransactionType {
  ADJUSTMENT
  DISPENSE
  REVERSAL
}

enum PatientConditionStatus {
  ACTIVE
  RESOLVED
}

enum HeaderBrandMode {
  ICON_AND_TEXT
  FULL_IMAGE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  EQUIPMENT
  MARKETING
  MAINTENANCE
  OTHER
}

enum ProviderType {
  DOCTOR
  STAFF
}

enum DoctorCategory {
  GENERAL_DENTISTRY
  ORTHODONTICS
  ENDODONTICS
  PERIODONTICS
  PEDIATRIC_DENTISTRY
  ORAL_SURGERY
  PROSTHODONTICS
  OTHER
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers               Provider[]
  settings                ClinicSetting?
  patientReferenceCounter PatientReferenceCounter?
  patients                Patient[]
  appointments            Appointment[]
  payments                Payment[]
  expenses                Expense[]
  reminders               Reminder[]
  medicines               Medicine[]
  prescriptions           Prescription[]
  contactMessages         ContactMessage[]
  mediaAssets             MediaAsset[]
  auditLogs               AuditLog[]

  @@index([active])
  @@index([name])
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  /// Reversible copy for ADMIN-only reveal of team member logins (AES). Never expose to STAFF.
  passwordEncrypted String?
  name              String
  phone             String?
  role              UserRole @default(STAFF)
  banned            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider Provider?
}

model Patient {
  id               String     @id @default(cuid())
  clinicId         String
  patientReference String
  name             String
  phone            String
  email            String?
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clinic        Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  payments      Payment[]
  reminders     Reminder[]
  prescriptions Prescription[]
  allergies     PatientAllergy[]
  conditions    PatientCondition[]
  encounters    Encounter[]

  @@unique([clinicId, patientReference])
  @@index([clinicId])
  @@index([phone])
  @@index([name])
  @@index([archivedAt])
}

model Provider {
  id           String          @id @default(cuid())
  clinicId     String
  name         String
  specialty    String?
  providerType ProviderType    @default(STAFF)
  category     DoctorCategory?
  phone        String?
  email        String?
  avatarUrl    String?
  active       Boolean         @default(true)
  /// Module keys staff may access in /admin (see staff-modules.ts). Empty = no modules.
  moduleAccess String[]        @default([])
  userId       String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  encounters   Encounter[]
  schedule     ProviderSchedule?

  @@index([clinicId])
  @@index([name])
  @@index([active])
  @@index([providerType])
}

/// Per-doctor availability (doctors only).
model ProviderSchedule {
  id                         String   @id @default(cuid())
  providerId                 String   @unique
  /// Slot length for this doctor's appointments (10–60 minutes).
  appointmentDurationMinutes Int      @default(30)
  /// Days present at clinic: 0=Sun … 6=Sat. Default Mon–Sat.
  workDays                   Int[]    @default([1, 2, 3, 4, 5, 6])
  workStartHour              Int      @default(9)
  workEndHour                Int      @default(18)
  lunchStartHour             Int      @default(13)
  lunchEndHour               Int      @default(14)
  /// When true, lunch hours follow clinic settings until the doctor customizes.
  useClinicHours             Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                 String              @id @default(cuid())
  clinicId           String
  patientId          String
  providerId         String?
  dateTime           DateTime
  durationMinutes    Int                 @default(30)
  bookingReference   String?             @unique
  status             AppointmentStatus   @default(PENDING)
  source             AppointmentSource   @default(ADMIN)
  paymentPreference  PaymentPreference?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider      Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  payments      Payment[]
  reminders     Reminder[]
  prescriptions Prescription[]
  encounters    Encounter[]

  @@index([clinicId])
  @@index([dateTime])
  @@index([status])
  @@index([patientId])
  @@index([providerId])
}

model Payment {
  id             String        @id @default(cuid())
  clinicId       String
  patientId      String
  appointmentId  String?
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  paidAt         DateTime      @default(now())
  notes          String?
  receiptNumber  String?       @unique
  voidedAt       DateTime?
  voidReason     String?
  voidedByUserId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([paidAt])
  @@index([method])
  @@index([patientId])
  @@index([voidedAt])
}

model Expense {
  id              String          @id @default(cuid())
  clinicId        String
  title           String
  category        ExpenseCategory @default(OTHER)
  amount          Decimal         @db.Decimal(12, 2)
  vendor          String?
  paidAt          DateTime        @default(now())
  method          PaymentMethod   @default(CASH)
  notes           String?
  referenceNumber String?         @unique
  voidedAt        DateTime?
  voidReason      String?
  voidedByUserId  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([paidAt])
  @@index([category])
  @@index([voidedAt])
}

model Reminder {
  id            String         @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  dueAt         DateTime
  message       String
  status        ReminderStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([dueAt])
  @@index([status])
  @@index([patientId])
}

model Medicine {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  strength      String?
  unit          String?
  stock         Int      @default(0)
  reorderLevel  Int      @default(10)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptionItems     PrescriptionItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([clinicId])
  @@index([name])
}

model InventoryTransaction {
  id              String                    @id @default(cuid())
  medicineId      String
  type            InventoryTransactionType
  quantity        Int
  note            String?
  prescriptionId  String?
  createdByUserId String?
  createdAt       DateTime                  @default(now())

  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@index([medicineId])
  @@index([prescriptionId])
  @@index([type])
  @@index([createdAt])
}

model Prescription {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  diagnosis     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment           Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items                 PrescriptionItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([clinicId])
  @@index([patientId])
  @@index([createdAt])
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  medicineId     String
  dosage         String
  duration       String?
  instructions   String?
  quantity       Int?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
}

model PatientAllergy {
  id        String   @id @default(cuid())
  patientId String
  name      String
  severity  String?
  notes     String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientCondition {
  id        String                 @id @default(cuid())
  patientId String
  name      String
  status    PatientConditionStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime               @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model Encounter {
  id             String   @id @default(cuid())
  patientId      String
  appointmentId  String?
  providerId     String?
  visitedAt      DateTime @default(now())
  chiefComplaint String?
  notes          String?
  vitalsJson     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  provider    Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([appointmentId])
  @@index([visitedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String?
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([createdAt])
  @@index([read])
}

model ClinicSetting {
  id                       String          @id @default(cuid())
  clinicId                 String          @unique
  clinicName               String          @default("Clinic")
  phone                    String?
  email                    String?
  address                  String?
  description              String?
  logoUrl                  String?
  headerBrandMode          HeaderBrandMode @default(ICON_AND_TEXT)
  patientReferenceTemplate String          @default("PAT-{YEAR}-{SEQ:6}")
  /// Lunch break start hour (0–23), inclusive. Default 13 = 1:00 PM.
  lunchStartHour           Int             @default(13)
  /// Lunch break end hour (0–23), exclusive. Default 14 = 2:00 PM.
  lunchEndHour             Int             @default(14)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Durable counter for concurrency-safe patient reference allocation (one row per clinic).
model PatientReferenceCounter {
  clinicId  String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Uploaded images/videos for branding, blogs, and other site content.
model MediaAsset {
  id           String    @id @default(cuid())
  clinicId     String
  originalName String
  fileName     String
  url          String
  mimeType     String
  type         MediaType
  sizeBytes    Int
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([type, createdAt])
  @@index([originalName])
}
